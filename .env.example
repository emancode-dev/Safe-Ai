# SafeShare AI configuration.
# Copy this file to ".env" and adjust if needed.

# Local Ollama HTTP endpoint. Keep this on localhost unless you intentionally
# target another trusted local-network Ollama service. A non-loopback value
# means your pasted text leaves this machine.
OLLAMA_BASE_URL=http://localhost:11434

# The locally installed Ollama model tag used for contextual analysis.
# Verified installed tag on the dev machine: qwen2.5:1.5b
# The explicit instruct alias qwen2.5:1.5b-instruct also exists in the Ollama
# library and resolves to the same instruct-tuned 1.5B model.
OLLAMA_MODEL=qwen2.5:1.5b

# Request timeout (seconds) for a single model invocation. The first call
# after startup can be slow while Ollama loads the model into memory.
OLLAMA_TIMEOUT=120
